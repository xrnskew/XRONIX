GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_CA_BUNDLE_FILE=certs/russian_bundle.pem

# Таймауты, секунды. Значения по умолчанию — под GigaChat-2 (бэк ждёт нас 30 с).
# Для GigaChat-3-Ultra (бэк ждёт 45 с): GIGACHAT_TIMEOUT_SEC=35, AI_DEADLINE_SEC=40, AI_MIN_RETRY_SEC=20
GIGACHAT_TIMEOUT_SEC=20
AI_DEADLINE_SEC=25
AI_DECIDE_TIMEOUT_SEC=8
AI_MIN_RETRY_SEC=10
