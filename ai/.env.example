GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_CA_BUNDLE_FILE=certs/russian_bundle.pem

# Таймауты, секунды. Значения по умолчанию — под GigaChat-2 и бэк, который ждёт нас 30 с.
# Прод: GigaChat-3-Ultra, бэк ждёт 170 с, фронт 180 с:
#   GIGACHAT_TIMEOUT_SEC=60, AI_DEADLINE_SEC=160, AI_DECIDE_TIMEOUT_SEC=15, AI_MIN_RETRY_SEC=30
GIGACHAT_TIMEOUT_SEC=20
AI_DEADLINE_SEC=25
AI_DECIDE_TIMEOUT_SEC=8
AI_MIN_RETRY_SEC=10
