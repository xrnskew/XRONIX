# Copy to backend/deploy/.env on the server; never commit that file.
MOCK_AI=true
AI_SERVICE_URL=http://ai:8001
CORS_ORIGINS=https://xronix.ru,https://www.xronix.ru,http://localhost:5173
# Empty = cryptographically random key generated at first boot in backend_data.
# If set manually: at least 32 random bytes; keep identical across restarts.
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
AI_REQUESTS_PER_MINUTE=6
AI_GLOBAL_PER_MINUTE=30
AI_MAX_CONCURRENT=4
API_REQUESTS_PER_MINUTE=120
AUTH_REQUESTS_PER_MINUTE=20
