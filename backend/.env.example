MOCK_AI=true
AI_SERVICE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set a random secret of at least 32 bytes in production.
# Empty locally: backend creates a persistent, private data/jwt.key.
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# Optional; default is absolute backend/data/xronix.db
# DATABASE_URL=sqlite:////absolute/path/to/xronix.db
# Optional; default is repository contracts directory
# CONTRACTS_DIR=/absolute/path/to/contracts
# Shared SQLite-backed request limits, fixed windows of 60 seconds.
AI_REQUESTS_PER_MINUTE=6
AI_GLOBAL_PER_MINUTE=30
AI_MAX_CONCURRENT=4
API_REQUESTS_PER_MINUTE=120
AUTH_REQUESTS_PER_MINUTE=20
# Daily native SQLite backups; production Compose enables this by default.
BACKUP_ENABLED=false
# BACKUP_DIR defaults to a private backups directory next to the database.
BACKUP_RETENTION_COUNT=7
BACKUP_TIMEOUT_SECONDS=30
DB_MIN_FREE_MB=100

# Password recovery through your VE3 SMTP account. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PUBLIC_APP_URL=https://xronix.ru/app
