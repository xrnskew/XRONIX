meta {
  name: Sign
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/applications/{{applicationId}}/sign
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{clientToken}}
}

body:json {
  {
    "version": {{version}}
  }
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test('Funded', () => expect(res.getBody().status).to.equal('funded'));
}
