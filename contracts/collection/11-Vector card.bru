meta {
  name: Vector card
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/bank/applications/{{vectorId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{analystToken}}
}

script:post-response {
  bru.setVar('vectorVersion', res.getBody().application.version);
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test('Checks available', () => expect(res.getBody().checks).to.have.length(4));
}
