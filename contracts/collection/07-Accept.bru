meta {
  name: Accept
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/applications/{{applicationId}}/accept
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{clientToken}}
}

body:json {
  {
    "version": {{version}}
  }
}

script:post-response {
  bru.setVar('version', res.getBody().version);
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test('Signing', () => expect(res.getBody().status).to.equal('signing'));
}
