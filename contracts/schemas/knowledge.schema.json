{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xronix/schemas/knowledge.schema.json",
  "title": "База знаний сервиса ai: факты о городах и банк фраз (ai.md, раздел «База знаний и банк фраз»)",
  "definitions": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "url", "license", "retrieved_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Как называть источник в тексте: «Росстат», «OpenStreetMap»" },
        "url": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1, "maxLength": 100 },
        "retrieved_at": { "type": "string", "format": "date" }
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "integer", "minimum": 0 },
        "source": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "id из sources" },
        "year": { "type": "integer", "minimum": 2015, "maximum": 2030, "description": "Год, к которому относится значение" },
        "scope": { "enum": ["city", "region"], "description": "Значение по городу или по региону (зарплата обычно по региону)" }
      }
    },
    "city": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "region"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Именительный падеж, как в cities.json" },
        "region": { "type": "string", "minLength": 1, "maxLength": 80 },
        "population": { "$ref": "#/definitions/fact" },
        "avg_salary_rub": { "$ref": "#/definitions/fact", "description": "Среднемесячная начисленная зарплата, рубли" },
        "venues": {
          "type": "object", "additionalProperties": false,
          "description": "Сколько заведений сферы в городе. Ключи — коды сфер templates/spheres.v1.json",
          "properties": {
            "coffee": { "$ref": "#/definitions/fact" },
            "bakery": { "$ref": "#/definitions/fact" },
            "car_wash": { "$ref": "#/definitions/fact" },
            "clothing_store": { "$ref": "#/definitions/fact" },
            "beauty_salon": { "$ref": "#/definitions/fact" },
            "pickup_point": { "$ref": "#/definitions/fact" }
          }
        },
        "registered_businesses": {
          "type": "object", "additionalProperties": false,
          "description": "Сколько ИП и компаний с ОКВЭД сферы зарегистрировано в городе (Единый реестр МСП ФНС). Ключи — коды сфер templates/spheres.v1.json. Это зарегистрированные, а не работающие точки; в тексте только «около N»",
          "properties": {
            "coffee": { "$ref": "#/definitions/fact" },
            "bakery": { "$ref": "#/definitions/fact" },
            "car_wash": { "$ref": "#/definitions/fact" },
            "clothing_store": { "$ref": "#/definitions/fact" },
            "beauty_salon": { "$ref": "#/definitions/fact" },
            "pickup_point": { "$ref": "#/definitions/fact" }
          }
        },
        "footfall": {
          "type": "object", "additionalProperties": false,
          "description": "Признаки проходимости по OpenStreetMap (данные неполные, в тексте только «около N»)",
          "properties": {
            "malls": { "$ref": "#/definitions/fact" },
            "universities": { "$ref": "#/definitions/fact" },
            "business_centers": { "$ref": "#/definitions/fact" }
          }
        },
        "income_per_capita_rub": { "$ref": "#/definitions/fact", "description": "Среднедушевые денежные доходы в месяц, рубли (Росстат, обычно по региону)" },
        "retail_turnover_per_capita_rub": { "$ref": "#/definitions/fact", "description": "Оборот розничной торговли на душу населения в месяц, рубли (Росстат, обычно по региону)" }
      }
    },
    "cities_file": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "generated_at", "sources", "cities"],
      "properties": {
        "comment": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "generated_at": { "type": "string", "format": "date" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/source" } },
        "cities": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/city" } }
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "variants"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 300, "description": "Когда сервис берёт эту фразу" },
        "sphere": { "enum": ["coffee", "bakery", "car_wash", "clothing_store", "beauty_salon", "pickup_point"], "description": "Только для фраз про одну сферу" },
        "variants": {
          "type": "array", "minItems": 3, "maxItems": 50,
          "items": {
            "type": "string", "minLength": 1, "maxLength": 400,
            "description": "Без цифр: числа подставляются только через {placeholder} из базы фактов или state",
            "pattern": "^[^0-9]*$"
          }
        }
      }
    },
    "phrases_file": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "generated", "slots"],
      "properties": {
        "comment": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "generated": {
          "type": "object", "additionalProperties": false,
          "required": ["tool", "date", "reviewed_by"],
          "properties": {
            "tool": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Чем сгенерированы варианты, например «GigaChat-2 Max через API»" },
            "date": { "type": "string", "format": "date" },
            "reviewed_by": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Кто вычитал" }
          }
        },
        "slots": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/definitions/slot" }
        }
      }
    }
  }
}
